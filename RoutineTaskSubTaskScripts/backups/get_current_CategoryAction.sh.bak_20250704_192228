#!/bin/bash

# --- Script Configuration ---
current_date=$(date +%Y-%m-%d)
JOURNAL_DIR="/home/aditya/obsidian/All Things/Journal/Daily Journal"
PLANNER_FILE="${JOURNAL_DIR}/${current_date}.md"
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"
OUTPUT_LOG_FILE="${SCRIPT_DIR}/current_routine.txt"
ENABLE_ALL_FILE_CONTENT_SECTION="true"
QUICK_RESULT_CONTENT="No active routine found."
current_routine_found="false"
current_routine_line_to_color=""
declare -a GLOBAL_ACTIVE_ROUTINE_LINES
declare -a GLOBAL_ACTIVE_ROUTINE_DESCRIPTIONS

# New Global Arrays for collecting all subtasks and linked notes
declare -a GLOBAL_COLLECTED_SUBTASKS
declare -a GLOBAL_COLLECTED_ROUTINE_LINKED_NOTES
declare -a GLOBAL_COLLECTED_SUBTASK_LINKED_NOTES

DEBUG_MODE="true" # Default to true for detailed debugging.
QUICK_MODE="false" # Default to false for full output.

# MODIFIED: New variable to store script start time
SCRIPT_START_TIME=$(date +"%Y-%m-%d %H:%M:%S")

# MODIFIED: New variable for the hardcoded Obsidian Vault Root
OBSIDIAN_VAULT_ROOT="/home/aditya/obsidian"

# Parse command-line arguments
for arg in "$@"; do
    case "$arg" in
        --debug=off)
            DEBUG_MODE="false"
            ;;
        --debug=on)
            DEBUG_MODE="true"
            ;;
        --quick)
            QUICK_MODE="true"
            ;;
        *)
            # Handle other arguments if needed, or ignore them
            ;;
    esac
done

# If QUICK_MODE is enabled, always disable DEBUG_MODE for clean output
if [ "$QUICK_MODE" = "true" ]; then
    DEBUG_MODE="false"
fi

GREEN='\e[0;32m'
BLUE='\e[0;34m'
CYAN='\e[0;36m'
YELLOW='\e[1;33m'
RED='\e[0;31m'
NC='\e[0m'

log_and_tee() {
    # The OUTPUT_LOG_FILE is now cleared directly at the start of the main script logic.
    # No need for .log_init_marker.
    echo -e "$@" | tee -a "$OUTPUT_LOG_FILE"
}

debug_log() {
    if [ "$DEBUG_MODE" = "true" ]; then
        log_and_tee "${BLUE}[DEBUG] $@${NC}"
    fi
}

get_display_width() {
    local stripped_string=$(echo -e "$1" | sed -E "s/\x1B\\[([0-9]{1,2}(;[0-9]{1,2})?)?[mGK]//g")
    echo "${#stripped_string}"
}

draw_routine_box() {
    local line_num="$1"
    local concise_name="$2"
    local content="${line_num}. ${concise_name}"
    local box_line_padding="  "
    local content_display_width=$(get_display_width "$content")
    local horizontal_line_width=$((content_display_width + (2 * ${#box_line_padding})))
    log_and_tee "${CYAN}╭$(printf '─%.0s' $(seq 1 $horizontal_line_width))╮${NC}"
    local spaces_needed_right=$((horizontal_line_width - content_display_width - ${#box_line_padding}))
    log_and_tee "${CYAN}│${box_line_padding}${content}${NC}$(printf ' %.0s' $(seq 1 $spaces_needed_right))${CYAN}│${NC}"
    log_and_tee "${CYAN}╰$(printf '─%.0s' $(seq 1 $horizontal_line_width))╯${NC}"
}

find_active_routine() {
    debug_log "Entering find_active_routine function."
    GLOBAL_ACTIVE_ROUTINE_LINES=()
    GLOBAL_ACTIVE_ROUTINE_DESCRIPTIONS=()
    local current_hour=$(date +%H)
    local current_minute=$(date +%M)
    local current_time_in_minutes=$((10#$current_hour * 60 + 10#$current_minute))
    debug_log "Current time: ${current_hour}:${current_minute} (${current_time_in_minutes} minutes)."
    local current_file_line_num=0

    # This check is now primarily for debugging within the function, initial file check is in main logic
    if [ ! -f "$PLANNER_FILE" ]; then
        log_and_tee "⚠️ Warning: Journal file '$PLANNER_FILE' not found during early routine scan."
        debug_log "Exiting find_active_routine due to missing planner file."
        return
    fi

    debug_log "Scanning planner file: $PLANNER_FILE"
    while IFS= read -r line; do
        current_file_line_num=$((current_file_line_num + 1))
        debug_log "Processing line ${current_file_line_num}: '$line'"
        # MODIFIED: New regex to capture content before and after time block more accurately
        # Old regex: if [[ "$line" =~ (.*)([0-9]{2}:[0-9]{2})[[:space:]]*-?[[:space:]]?([0-9]{2}:[0-9]{2}) ]]; then
        if [[ "$line" =~ (.*)([0-9]{2}:[0-9]{2})[[:space:]]*-?[[:space:]]?([0-9]{2}:[0-9]{2})(.*) ]]; then
            local routine_text_before_time="${BASH_REMATCH[1]}"
            local start="${BASH_REMATCH[2]}"
            local end="${BASH_REMATCH[3]}"
            local routine_text_after_time="${BASH_REMATCH[4]}"
            debug_log "  - Matched: Before Time='$routine_text_before_time', Start='$start', End='$end', After Time='$routine_text_after_time'"

            # Combine the parts before and after the time to form the full descriptive text
            local full_descriptive_text="${routine_text_before_time}${routine_text_after_time}"
            # Now, extract the description by removing the checkbox part from this full text
            local description=$(echo "$full_descriptive_text" | sed -E 's/^[[:space:]]*- ?\[ ?\] ?//' | xargs)
            debug_log "  - Extracted description: '$description'"

            local sh=$(echo "$start" | cut -d':' -f1)
            local sm=$(echo "$start" | cut -d':' -f2)
            local eh=$(echo "$end" | cut -d':' -f1)
            local em=$(echo "$end" | cut -d':' -f2)

            local start_min=$((10#$sh * 60 + 10#$sm))
            local end_min=$((10#$eh * 60 + 10#$em))
            debug_log "  - Start time in minutes: $start_min, End time in minutes: $end_min"

            if (( start_min > end_min )); then
                debug_log "  - Routine spans across midnight. Checking if current time (${current_time_in_minutes}) is >= $start_min OR < $end_min."
                if (( current_time_in_minutes >= start_min || current_time_in_minutes < end_min )); then
                    GLOBAL_ACTIVE_ROUTINE_LINES+=("$current_file_line_num")
                    GLOBAL_ACTIVE_ROUTINE_DESCRIPTIONS+=("$description")
                    debug_log "  - Routine identified as ACTIVE (spans midnight): Line ${current_file_line_num}, Desc: '$description'"
                else
                    debug_log "  - Routine NOT active (spans midnight)."
                fi
            else
                debug_log "  - Routine within same day. Checking if current time (${current_time_in_minutes}) is >= $start_min AND < $end_min."
                if (( current_time_in_minutes >= start_min && current_time_in_minutes < end_min )); then
                    GLOBAL_ACTIVE_ROUTINE_LINES+=("$current_file_line_num")
                    GLOBAL_ACTIVE_ROUTINE_DESCRIPTIONS+=("$description")
                    debug_log "  - Routine identified as ACTIVE: Line ${current_file_line_num}, Desc: '$description'"
                else
                    debug_log "  - Routine NOT active (same day)."
                fi
            fi
        else
            debug_log "  - Line does not match routine time pattern."
        fi
    done < "$PLANNER_FILE"

    if [ ${#GLOBAL_ACTIVE_ROUTINE_LINES[@]} -gt 0 ]; then
        current_routine_found="true"
        # The QUICK_RESULT_CONTENT now contains comma-separated descriptions of all active routines
        QUICK_RESULT_CONTENT="$(IFS=, ; echo "${GLOBAL_ACTIVE_ROUTINE_DESCRIPTIONS[*]}")"
        debug_log "Active routines found: ${#GLOBAL_ACTIVE_ROUTINE_LINES[@]}. QUICK_RESULT_CONTENT updated."
        debug_log "Collected active routines (descriptions): '${QUICK_RESULT_CONTENT}'"
    else
        current_routine_found="false"
        QUICK_RESULT_CONTENT="No active routine found."
        debug_log "No active routines found."
    fi
    debug_log "Exiting find_active_routine function."
}

# --- New Helper Function: Get Leading Spaces ---
get_leading_spaces() {
    local line="$1"
    # Convert tabs to spaces (assuming 4 spaces per tab for Markdown consistency)
    # If your editor/Markdown style uses a different tab width, adjust --tabs=N accordingly.
    local line_with_spaces_only=$(echo "$line" | expand --tabs=4)
    [[ "$line_with_spaces_only" =~ ^( *) ]]
    echo "${#BASH_REMATCH[1]}"
}

# --- New Helper Function: Get Concise Routine Name ---
get_concise_routine_name() {
    local full_routine_line="$1"
    local temp_name

    # 1. Remove leading spaces and the optional '- [ ] ' part.
    temp_name=$(echo "$full_routine_line" | sed -E 's/^[[:space:]]*-?[[:space:]]*\[[[:space:]]*\][[:space:]]*//')

    # 2. Remove the time range (HH:MM - HH:MM) from anywhere in the string.
    #    This pattern is HH:MM, optional space, hyphen, optional space, HH:MM.
    #    The 'g' flag ensures global replacement if multiple time patterns existed (unlikely but robust).
    temp_name=$(echo "$temp_name" | sed -E 's/[0-9]{2}:[0-9]{2}[[:space:]]*-?[[:space:]]?[0-9]{2}:[0-9]{2}//g')

    # 3. Use xargs to trim any remaining leading/trailing whitespace.
    echo "$temp_name" | xargs
}

# --- New Function: Process Routine Details and Consideration List ---
# MODIFIED: Added parent_section_prefix parameter
process_routine_details() {
    local parent_section_prefix="$1" # New parameter for the parent section prefix
    local routine_start_line=$2
    local routine_leading_indent=$3
    local routine_desc=$4
    local full_routine_line_content=$5 # New parameter for the full line content

    local subtasks_with_line_numbers=()
    local -a routine_linked_notes=()
    local -a subtask_linked_notes=()

    debug_log "Entering process_routine_details for line ${routine_start_line} with indent ${routine_leading_indent}."

    # MODIFIED: Extract linked notes from the full routine line content (ensures all text is considered)
    # Old: local raw_routine_notes=$(echo "$routine_desc" | grep -oP '\[\[.*?\]\]')
    local raw_routine_notes=$(echo "$full_routine_line_content" | grep -oP '\[\[.*?\]\]')
    if [ -n "$raw_routine_notes" ]; then
        readarray -t notes_from_routine_desc <<< "$raw_routine_notes"
        for note in "${notes_from_routine_desc[@]}"; do
            routine_linked_notes+=("${routine_start_line}: 🔗 ${note}")
            debug_log "  - Found routine linked note: ${note}"
        done
    fi

    local current_line_num=$((routine_start_line + 1))
    local -a raw_lines_to_process

    # Read subsequent lines from the planner file starting from the line after the routine
    # Stop when an empty line is encountered, or a line with less or equal indentation, or end of file
    while IFS= read -r line_content; do
        debug_log "  - Scanning subsequent line ${current_line_num}: '${line_content}'"
        if [ -z "$line_content" ]; then
            debug_log "  - Encountered empty line, stopping subtask scan."
            break # Stop at first empty line
        fi

        current_indent=$(get_leading_spaces "$line_content")
        debug_log "  - Subtask candidate indent: ${current_indent}, Routine indent: ${routine_leading_indent}"
        if (( current_indent > routine_leading_indent )); then
            subtasks_with_line_numbers+=("${current_line_num}: ${line_content}")
            debug_log "  - Identified subtask: '${line_content}' (indent: ${current_indent})"

            # Extract linked notes from subtask and search in their content
            # Store with their source line number
            local raw_subtask_notes=$(echo "$line_content" | grep -oP '\[\[.*?\]\]')
            if [ -n "$raw_subtask_notes" ]; then
                readarray -t notes_from_subtask <<< "$raw_subtask_notes"
                for note in "${notes_from_subtask[@]}"; do
                    subtask_linked_notes+=("${current_line_num}: 🔗 ${note}")
                done # Corrected this line to 'done'
            fi
        else
            debug_log "  - Line has less or equal indentation, stopping subtask scan."
            break # Stop if indentation is not greater
        fi
        current_line_num=$((current_line_num + 1))
    done < <(tail -n +$((routine_start_line + 1)) "$PLANNER_FILE")

    local concise_routine_name=$(get_concise_routine_name "$full_routine_line_content")
    # For debugging purpose within the function
    # These lines are now explicitly printed to stdout as requested, colored for visibility.
    log_and_tee "\n${CYAN}  Full Line Content: '${full_routine_line_content}'${NC}"
    log_and_tee "${CYAN}  Concise Routine Name: '${concise_routine_name}'${NC}"
    log_and_tee "${CYAN}  Routine Box text: ${routine_start_line}. ${concise_routine_name}${NC}"

    # MODIFIED: ROUTINE BOX IS NOW HERE, content shows line number + concise routine name
    # MODIFIED: Prepend parent_section_prefix to all internal headings
    log_and_tee "\n${CYAN}  ${parent_section_prefix}.1 Routine Header (Line ${routine_start_line}):${NC}" # L2 - CYAN, Relative to current routine
    draw_routine_box "${routine_start_line}" "${concise_routine_name}"
    log_and_tee "    Leading Indent: ${routine_leading_indent} spaces"
    log_and_tee ""

    # MODIFIED: Prepend parent_section_prefix to all internal headings
    log_and_tee "${CYAN}  ${parent_section_prefix}.2 CONSIDERATION LIST FOR CURRENT ROUTINE ---${NC}" # L2 - CYAN, Relative to current routine
    log_and_tee ""

    # MODIFIED: Prepend parent_section_prefix to all internal headings
    log_and_tee "${BLUE}  ${parent_section_prefix}.2.1 Subtasks Considered ---${NC}" # L3 - BLUE, Relative to current routine
    if [ ${#subtasks_with_line_numbers[@]} -gt 0 ]; then
        for task_info in "${subtasks_with_line_numbers[@]}"; do
            log_and_tee "    - ${task_info}"
        done
    else
        log_and_tee "    ℹ️ No subtasks found for this routine."
    fi
    log_and_tee ""

    # MODIFIED: Prepend parent_section_prefix to all internal headings
    log_and_tee "${BLUE}  ${parent_section_prefix}.2.2 Linked Notes Considered ---${NC}" # L3 - BLUE, Relative to current routine
    log_and_tee ""

    # From Routine Description
    if [ ${#routine_linked_notes[@]} -gt 0 ]; then
        # MODIFIED: Prepend parent_section_prefix to all internal headings
        log_and_tee "${GREEN}  ${parent_section_prefix}.2.2.1 From linked notes found in the routine name:${NC}" # L4 - GREEN, Relative to current routine
        for note in "${routine_linked_notes[@]}"; do
            log_and_tee "      ${note}"
        done
    else
        # MODIFIED: Prepend parent_section_prefix to all internal headings
        log_and_tee "${GREEN}  ${parent_section_prefix}.2.2.1 From linked notes found in the routine name:${NC}" # L4 - GREEN
        log_and_tee "      0 (No linked notes found)"
    fi
    log_and_tee ""

    # From Subtasks
    if [ ${#subtask_linked_notes[@]} -gt 0 ]; then
        # MODIFIED: Prepend parent_section_prefix to all internal headings
        log_and_tee "${GREEN}  ${parent_section_prefix}.2.2.2 From Subtasks:${NC}" # L4 - GREEN, Relative to current routine
        for note in "${subtask_linked_notes[@]}"; do
            log_and_tee "      ${note}"
        done # CORRECTED: Changed '}' to 'done'
    else
        # MODIFIED: Prepend parent_section_prefix to all internal headings
        log_and_tee "${GREEN}  ${parent_section_prefix}.2.2.2 From Subtasks:${NC}" # L4 - GREEN
        log_and_tee "      0 (No linked notes found)"
    fi
    log_and_tee ""

    debug_log "Exiting process_routine_details."
}

# --- New Global Variables for Tag Search Results ---
declare -A TAG_DEFINITIONS
TAG_DEFINITIONS["#CurrentCategoryOrAction"]="Current Category Action"

# NEW: Array to define explicit display order for tags
# This ensures the order you requested for presentation in section 5.1
TAG_DISPLAY_ORDER=(
    "#CurrentCategoryOrAction"
)

# MODIFIED: Changed FOUND_TAGS_RESULTS to an associative array to store the first result per tag
declare -A FOUND_TAGS_RESULTS
# MODIFIED: New associative array to track if a tag has been found
declare -A TAG_FOUND_STATUS

# MODIFIED: New Helper Function: Resolve Obsidian Note Path (Simplified with exclusion) ---
resolve_obsidian_note_path() {
    local note_name_raw="$1"
    # Remove [[ and ]]
    local note_name=$(echo "$note_name_raw" | sed 's/^\[\[//;s/\]\]$//')
    local potential_path=""

    debug_log "  - Resolving Obsidian note path for: '${note_name}' by searching entire vault: '${OBSIDIAN_VAULT_ROOT}' (excluding .trash folder)"

    # Directly search within the specified OBSIDIAN_VAULT_ROOT and its subdirectories
    if [ -d "$OBSIDIAN_VAULT_ROOT" ]; then
        # Use find to locate the note, prioritizing exact match, then case-insensitive
        # Exclude the .trash folder using -path and -prune
        local found_note_path=$(find "$OBSIDIAN_VAULT_ROOT" \
            -path "${OBSIDIAN_VAULT_ROOT}/.trash" -prune -o \
            -type f \( -name "${note_name}.md" -o -iname "${note_name}.md" \) -print -quit 2>/dev/null)
        if [ -n "$found_note_path" ]; then
            debug_log "    - Found (via find in specified vault root, excluding .trash): ${found_note_path}"
            echo "$found_note_path"
            return
        fi
    else
        debug_log "    - Warning: Specified OBSIDIAN_VAULT_ROOT directory does not exist or is not a directory: '${OBSIDIAN_VAULT_ROOT}'"
    fi

    debug_log "    - Note not found within the specified vault root: '${note_name}'"
    echo "" # Return empty if not found
}

# --- New Function: Search for Tags in Content ---
# MODIFIED: Now stores result in FOUND_TAGS_RESULTS associative array for "first match wins"
search_for_tags_in_content() {
    local content_source="$1" # e.g., "Subtask", "Routine Linked Note", "Subtask Linked Note"
    local content_text="$2"   # The actual text to search within (line content or file content)
    local routine_desc="$3"   # Description of the routine
    local source_file="$4"    # File where content was found (e.g., PLANNER_FILE or linked note path)
    local line_num="$5"       # Line number within the source_file (can be "line N" or "line N (file content)")
    local target_tag="$6"     # The specific tag to search for in this call

    # Check if this specific tag has already been found for the "first match wins" logic
    if [ "${TAG_FOUND_STATUS[$target_tag]}" = "true" ]; then
        debug_log "      - Tag '${target_tag}' already found. Skipping search for this instance."
        return 1 # Indicate that no new result was found for this tag
    fi

    debug_log "      - Searching for target tag '${target_tag}' in '${content_source}' (Routine: '${routine_desc}') from '${source_file}', Line: ${line_num}"

    # Only search for the specific target tag
    local tag_display_name="${TAG_DEFINITIONS[$target_tag]}"
    # Use grep -q to check for presence efficiently
    if echo "$content_text" | grep -q -- "$target_tag"; then
        debug_log "        - Found tag '${target_tag}' (as '${tag_display_name}') in '${content_source}'."
        # Store the first result for this tag in the associative array
        FOUND_TAGS_RESULTS["$target_tag"]=$(
            cat <<-EOF
            File: ${BLUE}${source_file}${NC}
            Line: ${line_num}
            Content: ${content_text}
EOF
        )
        TAG_FOUND_STATUS["$target_tag"]="true" # Mark this tag as found
        return 0 # Indicate success
    fi
    return 1 # Indicate that the tag was not found in this content
}

# --- New Function: collect_all_considerations_from_routines ---
collect_all_considerations_from_routines() {
    debug_log "Entering collect_all_considerations_from_routines function."
    GLOBAL_COLLECTED_SUBTASKS=()
    GLOBAL_COLLECTED_ROUTINE_LINKED_NOTES=()
    GLOBAL_COLLECTED_SUBTASK_LINKED_NOTES=()

    if [ ${#GLOBAL_ACTIVE_ROUTINE_LINES[@]} -eq 0 ]; then
        debug_log "  No active routines to collect considerations from."
        return
    fi

    for i in "${!GLOBAL_ACTIVE_ROUTINE_LINES[@]}"; do
        local routine_line_num="${GLOBAL_ACTIVE_ROUTINE_LINES[$i]}"
        local routine_desc="${GLOBAL_ACTIVE_ROUTINE_DESCRIPTIONS[$i]}" # This is the extracted description
        local full_routine_line_content=$(sed -n "${routine_line_num}p" "$PLANNER_FILE")
        local routine_indent=$(get_leading_spaces "$full_routine_line_content")
        local concise_routine_name=$(get_concise_routine_name "$full_routine_line_content")

        debug_log "  Collecting considerations for Routine: '${concise_routine_name}' (Line: ${routine_line_num})"

        # Collect Routine Linked Notes
        local raw_routine_notes=$(echo "$full_routine_line_content" | grep -oP '\[\[.*?\]\]')
        if [ -n "$raw_routine_notes" ]; then
            readarray -t notes_from_routine_desc <<< "$raw_routine_notes"
            for note_name_raw in "${notes_from_routine_desc[@]}"; do
                local resolved_path=$(resolve_obsidian_note_path "$note_name_raw")
                local path_info=""
                if [ -n "$resolved_path" ]; then
                    path_info=" (PATH: ${resolved_path})"
                else
                    path_info=" (PATH: Not Found)"
                fi
                GLOBAL_COLLECTED_ROUTINE_LINKED_NOTES+=("${routine_line_num}: ${concise_routine_name}: 🔗 ${note_name_raw}${path_info}")
                debug_log "    - Collected routine linked note: ${note_name_raw}${path_info}"
            done
        fi

        # Collect Subtasks and their Linked Notes
        local current_scan_line_num=$((routine_line_num + 1))
        while IFS= read -r line_content; do
            if [ -z "$line_content" ]; then
                debug_log "      - Empty line encountered, stopping subtask scan for this routine."
                break
            fi

            local current_indent=$(get_leading_spaces "$line_content")
            if (( current_indent > routine_indent )); then
                GLOBAL_COLLECTED_SUBTASKS+=("${current_scan_line_num}: ${concise_routine_name}: ${line_content}")
                debug_log "      - Collected subtask: '${line_content}'"

                local raw_subtask_notes=$(echo "$line_content" | grep -oP '\[\[.*?\]\]')
                if [ -n "$raw_subtask_notes" ]; then
                    readarray -t notes_from_subtask <<< "$raw_subtask_notes"
                    for note_name_raw in "${notes_from_subtask[@]}"; do
                        local resolved_path=$(resolve_obsidian_note_path "$note_name_raw")
                        local path_info=""
                        if [ -n "$resolved_path" ]; then
                            path_info=" (PATH: ${resolved_path})"
                        else
                            path_info=" (PATH: Not Found)"
                        fi
                        GLOBAL_COLLECTED_SUBTASK_LINKED_NOTES+=("${current_scan_line_num}: ${concise_routine_name}: 🔗 ${note_name_raw}${path_info}")
                        debug_log "        - Collected subtask linked note: ${note_name_raw}${path_info}"
                    done
                fi
            else
                debug_log "      - Line has less or equal indentation, stopping subtask scan for this routine."
                break
            fi
            current_scan_line_num=$((current_scan_line_num + 1))
        done < <(tail -n +$((routine_line_num + 1)) "$PLANNER_FILE")
    done
    debug_log "Exiting collect_all_considerations_from_routines function."
}


# --- New Section: find_tags_in_consideration_list ---
# MODIFIED: Now uses GLOBAL_COLLECTED_* arrays
# MODIFIED: Changed search order to: 1. Subtasks, 2. Routine Linked Notes, 3. Subtask Linked Notes
# MODIFIED: Added specific tag order search based on TAG_DISPLAY_ORDER
# MODIFIED: Implements "first match wins" logic for each tag
find_tags_in_consideration_list() {
    debug_log "Entering find_tags_in_consideration_list function (MODIFIED for enhanced debug output, 'first match wins' logic)."
    
    # Only search for #CurrentCategoryOrAction
    local current_search_tag="#CurrentCategoryOrAction"
    TAG_FOUND_STATUS["$current_search_tag"]="false"
    FOUND_TAGS_RESULTS["$current_search_tag"]=""

    debug_log "  Starting search for tag: ${current_search_tag}"

    # --- Search Priority 1: Collected Subtasks ---
    debug_log "    Searching in GLOBAL_COLLECTED_SUBTASKS for '${current_search_tag}'."
    for entry in "${GLOBAL_COLLECTED_SUBTASKS[@]}"; do
        local line_num_info=$(echo "$entry" | cut -d':' -f1)
        local routine_name=$(echo "$entry" | cut -d':' -f2 | xargs)
        local subtask_content=$(echo "$entry" | sed -E 's/^[0-9]+:[^:]+:[[:space:]]*(.*)$/\1/')
        debug_log "      - Searching for target tag '${current_search_tag}' in 'Subtask' (Routine: '${routine_name}') from '${PLANNER_FILE}', Line: ${line_num_info}"

        if search_for_tags_in_content "Subtask" "$subtask_content" "${routine_name}" "$PLANNER_FILE" "${line_num_info}" "${current_search_tag}"; then
            debug_log "      Found '${current_search_tag}' in Subtask. Exiting search for this tag."
            return # Exit the function as the only tag needed is found
        fi
    done

    # --- Search Priority 2: Collected Routine Linked Notes ---
    debug_log "    Searching in GLOBAL_COLLECTED_ROUTINE_LINKED_NOTES for '${current_search_tag}'."
    for entry in "${GLOBAL_COLLECTED_ROUTINE_LINKED_NOTES[@]}"; do
        local line_num_info=$(echo "$entry" | cut -d':' -f1)
        local routine_name=$(echo "$entry" | cut -d':' -f2 | xargs)
        local note_raw=$(echo "$entry" | sed -E 's/^[0-9]+:[^:]+:[[:space:]]*🔗[[:space:]]*(.*)$/\1/')
        # Remove the path info if it exists, to get the raw note name for resolution
        note_raw=$(echo "$note_raw" | sed -E 's/\s*\(PATH:.*\)//')
        debug_log "      - Searching for target tag '${current_search_tag}' in 'Routine Linked Note' (Routine: '${routine_name}') from '${PLANNER_FILE}', Line: ${line_num_info}"

        local linked_note_path=$(resolve_obsidian_note_path "$note_raw")
        if [ -n "$linked_note_path" ] && [ -f "$linked_note_path" ]; then
            local note_content=$(<"$linked_note_path")
            if search_for_tags_in_content "Routine Linked Note (from file: '${note_raw}')" "$note_content" "${routine_name}" "$linked_note_path" "${line_num_info} (file content)" "${current_search_tag}"; then
                debug_log "      Found '${current_search_tag}' in Routine Linked Note file. Exiting search for this tag."
                return
            fi
        fi

        # Also search in the raw collected note string itself
        if search_for_tags_in_content "Routine Name (via collected note reference: '${note_raw}')" "$entry" "${routine_name}" "$PLANNER_FILE" "${line_num_info} (note reference string)" "${current_search_tag}"; then
            debug_log "      Found '${current_search_tag}' in Routine Linked Note reference string. Exiting search for this tag."
            return
        fi
    done

    # --- Search Priority 3: Collected Subtask Linked Notes ---
    debug_log "    Searching in GLOBAL_COLLECTED_SUBTASK_LINKED_NOTES for '${current_search_tag}'."
    for entry in "${GLOBAL_COLLECTED_SUBTASK_LINKED_NOTES[@]}"; do
        local line_num_info=$(echo "$entry" | cut -d':' -f1)
        local routine_name=$(echo "$entry" | cut -d':' -f2 | xargs)
        local note_raw=$(echo "$entry" | sed -E 's/^[0-9]+:[^:]+:[[:space:]]*🔗[[:space:]]*(.*)$/\1/')
        # Remove the path info if it exists, to get the raw note name for resolution
        note_raw=$(echo "$note_raw" | sed -E 's/\s*\(PATH:.*\)//')
        debug_log "      - Searching for target tag '${current_search_tag}' in 'Subtask Linked Note' (Routine: '${routine_name}') from '${PLANNER_FILE}', Line: ${line_num_info}"

        local linked_note_path=$(resolve_obsidian_note_path "$note_raw")
        if [ -n "$linked_note_path" ] && [ -f "$linked_note_path" ]; then
            local note_content=$(<"$linked_note_path")
            if search_for_tags_in_content "Subtask Linked Note (from file: '${note_raw}')" "$note_content" "${routine_name}" "$linked_note_path" "${line_num_info} (file content)" "${current_search_tag}"; then
                debug_log "      Found '${current_search_tag}' in Subtask Linked Note file. Exiting search for this tag."
                return
            fi
        fi

        # Also search in the raw collected note string itself
        if search_for_tags_in_content "Subtask (via collected note reference: '${note_raw}')" "$entry" "${routine_name}" "$PLANNER_FILE" "${line_num_info} (note reference string)" "${current_search_tag}"; then
            debug_log "      Found '${current_search_tag}' in Subtask Linked Note reference string. Exiting search for this tag."
            return
        fi
    done

    debug_log "Exiting find_tags_in_consideration_list function."
}


