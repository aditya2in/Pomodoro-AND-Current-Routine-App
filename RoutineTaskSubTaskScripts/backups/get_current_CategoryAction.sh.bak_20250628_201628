#!/bin/bash

# --- Diagnostic Line ---
# This line will help us understand which shell is actually running this script.
echo "Running with SHELL: $0, BASH_VERSION: $BASH_VERSION"
# --- End Diagnostic Line ---

# Get the current date in Букмекерлар-MM-DD format
current_date=$(date +%Y-%m-%d)

# Define the planner file name using the current date variable
# Ensure this path is correct for your daily journal files
PLANNER_FILE="/home/aditya/obsidian/All Things/Journal/Daily Journal/${current_date}.md"

# Define the root path to your Obsidian vault
# This is crucial for searching linked notes
OBSIDIAN_VAULT_PATH="/home/aditya/obsidian"

# Define a static output file name. This file will store the script's output.
OUTPUT_FILE="current_routine.txt"

# --- Variables to store data for QuickResult ---
# These variables will store the final quick result values to be used in the combined output.
quick_result_routine_name=""
quick_result_category_action=""
# --- End QuickResult variables ---

# Initialize output_content string that will accumulate all parts of the output *after* the quick result.
output_content=""

# Get the current hour and minute for time-based routine matching
current_hour=$(date +%H)
current_minute=$(date +%M)

# Convert current time to total minutes from midnight for easy comparison
current_total_minutes=$((10#$current_hour * 60 + 10#$current_minute))

# Check if today's planner file exists. If not, populate error content and set quick result values, then exit.
if [ ! -f "$PLANNER_FILE" ]; then
    output_content+="--------------------------------------------------------\n"
    output_content+="Starting Routine, Action List, and Category/Action retrieval for $current_date at $(date)\n"
    output_content+="--------------------------------------------------------\n"
    output_content+="Error: Planner file '$PLANNER_FILE' not found. Please ensure your daily journal is in the specified path.\n"
    output_content+="--------------------------------------------------------\n"

    quick_result_routine_name="No Active Routine" # Set for quick result section
    quick_result_category_action="NONE" # Set for quick result section

    # Ensure to also print the final output location even on early exit
    output_content+="Script finished at $(date)\n"
    output_content+="Output captured in: $(pwd)/$OUTPUT_FILE\n"

    # --- Final Print to STDOUT and File (for early exit) ---
    # This block now prepares the quick result and combines it with output_content for unified print.
    final_combined_output="🚀 QUICK RESULT\n"
    final_combined_output+="$quick_result_routine_name\n"
    final_combined_output+="$quick_result_category_action\n"
    final_combined_output+="--------------------------------------------------------\n"
    final_combined_output+="$output_content"

    echo -e "$final_combined_output" > "$OUTPUT_FILE"
    echo -e "$final_combined_output"

    exit 1
fi

# Append initial logging information (This comes *after* the quick result, so no quick result data here).
output_content+="ℹ️ INFORMATION ABOUT THE SCRIPT\n"
output_content+="--------------------------------------------------------\n"
output_content+="Starting Routine, Action List, and Category/Action retrieval for $current_date at $(date)\n"
output_content+="Planner file processed: $PLANNER_FILE\n"
output_content+="--------------------------------------------------------\n"

# Initialize an empty array to store all matched routine descriptions along with their line numbers.
matched_routines_with_lines=()
line_num=0 # Counter for current line number in the planner file

# Loop through the planner file line by line to identify active routines.
while IFS= read -r line || [[ -n "$line" ]]; do
    line_num=$((line_num + 1))
    # Check if the line contains a time pattern (e.g., "HH:MM - HH:MM")
    if [[ "$line" =~ ([0-9]{2}:[0-9]{2})\ -\ ([0-9]{2}:[0-9]{2}) ]]; then
        start_time_str="${BASH_REMATCH[1]}" # Capture start time (e.g., "08:00")
        end_time_str="${BASH_REMATCH[2]}"   # Capture end time (e.g., "09:00")

        # Extract the routine description by removing the time pattern and leading bullet/checkbox.
        routine_description_raw="${line#*- \[ \] }"
        routine_description_final=$(echo "$routine_description_raw" | sed -E 's/\s*([0-9]{2}:[0-9]{2})\s*-\s*([0-9]{2}:[0-9]{2})\s*//' | xargs)

        # Parse start and end times into hour and minute components.
        start_hour=${start_time_str%:*}
        start_minute=${start_time_str#*:}
        end_hour=${end_time_str%:*}
        end_minute=${end_time_str#*:}

        # Convert routine start and end times to total minutes from midnight for comparison.
        # Fixed: Use start_minute for start_total_minutes, not current_minute.
        start_total_minutes=$((10#$start_hour * 60 + 10#$start_minute))
        end_total_minutes=$((10#$end_hour * 60 + 10#$end_minute))

        # Check if the current system time falls within the routine's time slot.
        # This condition handles routines that cross midnight (e.g., 23:00 - 02:00).
        if (( current_total_minutes >= start_total_minutes && current_total_minutes < end_total_minutes )) || \
           ( (( end_total_minutes < start_total_minutes )) && \
             ( (current_total_minutes >= start_total_minutes) || (current_total_minutes < end_total_minutes) ) ) ; then

            # If the routine is active, add its description and line number to the array.
            matched_routines_with_lines+=("${line_num}|${routine_description_final}")
        fi
    fi
done < "$PLANNER_FILE"

# Initialize new arrays for grouped consideration list items
# These will be populated per routine and then used for the combined search
# (moved outside loop to store all for combined search)
linked_notes_from_routine_name_items_all=()
direct_subtask_items_all=()
linked_notes_from_subtasks_items_all=()

# Initialize an associative array to store consideration items per routine for grouped display
declare -A routine_consideration_items_map

# Process the identified active routines to extract their associated action list items.
if [ ${#matched_routines_with_lines[@]} -gt 0 ]; then
    output_content+="🗓️ ROUTINE DECLARATION\n"
    output_content+="----------------------------------------\n"

    # Populate quick_result_routine_name_parts for quick result section
    quick_result_routine_name_parts=()

    for routine_item_with_line in "${matched_routines_with_lines[@]}"; do
        IFS='|' read -r routine_line_num routine_description <<< "$routine_item_with_line"
        output_content+="➡️ $routine_description (Line: $routine_line_num)\n"
        quick_result_routine_name_parts+=("$routine_description")
        
        # New: Collect linked notes from routine name for *this specific routine's* consideration list
        declare -a current_routine_linked_notes_from_name=()
        if [[ "$routine_description" =~ \[\[([^]]+)\]\] ]]; then
            linked_note_from_routine="${BASH_REMATCH[1]}"
            current_routine_linked_notes_from_name+=("((from [[${linked_note_from_routine}]]))") # Indicate source
            linked_notes_from_routine_name_items_all+=("((from [[${linked_note_from_routine}]]))") # Add to overall list for search
        fi

        # Use awk to extract indented list items immediately following the routine line.
        # This identifies action list items associated with the routine.
        # Captures original line number and original content including indentation.
        routine_tasks_with_lines_and_indentation=$(awk -v start_line="$routine_line_num" '
            NR > start_line {
                current_line_content = $0;
                # Determine current line\'s indentation
                if (match(current_line_content, /^[[:space:]]*/)) {
                    current_indent = RLENGTH;
                } else {
                    current_indent = 0;
                }

                # Check if it\'s a list item (starts with -, *, or digit.) and has increased indentation
                if (current_indent > 0 && (current_line_content ~ /^[[:space:]]+[-*]\s/ || current_line_content ~ /^[[:space:]]+[0-9]+\.\s/ || current_line_content ~ /^[[:space:]]+- \[.\]\s/)) {
                    print NR ":" current_line_content; # Print line number followed by original line content
                } else {
                    # Stop processing if a non-indented list item or a different section is encountered
                    exit;
                }
            }
        ' "$PLANNER_FILE")

        declare -a current_routine_direct_subtask_items=()
        declare -a current_routine_linked_notes_from_subtasks=()

        if [ -n "$routine_tasks_with_lines_and_indentation" ]; then
            while IFS=: read -r task_line_num task_full_content; do
                current_routine_direct_subtask_items+=("$task_line_num:$task_full_content") # Keep original line num and content
                direct_subtask_items_all+=("$task_full_content") # Add to overall list for search (content only)

                # If the task contains a linked note, add it to the specific array for subtask-level links.
                if [[ "$task_full_content" =~ \[\[([^]]+)\]\] ]]; then
                    linked_note_from_task="${BASH_REMATCH[1]}"
                    current_routine_linked_notes_from_subtasks+=("((from [[${linked_note_from_task}]]) (Line: $task_line_num))") # Indicate source and line
                    linked_notes_from_subtasks_items_all+=("((from [[${linked_note_from_task}]]) (Line: $task_line_num))") # Add to overall list for search
                fi
            done <<< "$routine_tasks_with_lines_and_indentation"
        fi

        # Store these for grouped display in the consideration list.
        # Using a newline-separated string for simplicity in bash map, then split later.
        routine_consideration_items_map["${routine_description}|${routine_line_num}_linked_from_name"]=$(IFS=$'\n'; echo "${current_routine_linked_notes_from_name[*]}")
        routine_consideration_items_map["${routine_description}|${routine_line_num}_subtasks"]=$(IFS=$'\n'; echo "${current_routine_direct_subtask_items[*]}")
        routine_consideration_items_map["${routine_description}|${routine_line_num}_linked_from_subtasks"]=$(IFS=$'\n'; echo "${current_routine_linked_notes_from_subtasks[*]}")

    done
    output_content+="\n"

    # Join multiple routine names with " CAPITAL AND " for quick result
    IFS=' CAPITAL AND ' quick_result_routine_name="${quick_result_routine_name_parts[*]}"

else
    output_content+="🗓️ ROUTINE DECLARATION\n"
    output_content+="----------------------------------------\n"
    output_content+="🎯 No active routines found for the current time.\n"
    output_content+="----------------------------------------\n\n"
    quick_result_routine_name="No Active Routine" # Set for quick result section
fi

# Initialize a temporary array for the new unified consideration list (tasks + all linked notes)
# This array will be populated by consolidating the grouped arrays in priority order.
all_consideration_list_items=()

# Populate all_consideration_list_items in the specified priority order:
# 1. Direct Subtasks (content only, for search)
for item in "${direct_subtask_items_all[@]}"; do
    all_consideration_list_items+=("$item")
done

# 2. Linked Notes from Routine Name (for search)
for item in "${linked_notes_from_routine_name_items_all[@]}"; do
    all_consideration_list_items+=("$item")
done

# 3. Linked Notes from Subtasks (for search)
for item in "${linked_notes_from_subtasks_items_all[@]}"; do
    all_consideration_list_items+=("$item")
done


# --- Determine the category/action ---
category_action_found=""
category_action_source_info=""
found_category_actions_list=()

# Use a map to track unique found category actions to avoid duplicates in the duplicate check list.
declare -A temp_unique_found_category_actions_map


# Attempt to find #CategoryOrAction within the unified consideration list based on new priority.
for item_to_consider in "${all_consideration_list_items[@]}"; do
    if [[ "$item_to_consider" =~ \#CategoryOrAction ]]; then
        # Found directly in a task or a representation string from a linked note
        
        # Add to the list of all found tags for duplicate check, ensuring uniqueness
        if [[ ! -v temp_unique_found_category_actions_map["$item_to_consider"] ]]; then
            found_category_actions_list+=("$item_to_consider")
            temp_unique_found_category_actions_map["$item_to_consider"]=1
        fi

        # If no category_action_found yet, set this one as the primary.
        if [ -z "$category_action_found" ]; then
            category_action_found="$item_to_consider"
            category_action_source_info="" # Reset if found directly in task
            
            # Check if the direct match came from a line number prefix (from direct subtask extraction)
            if [[ "$category_action_found" =~ ^([0-9]+):\s*(.*) ]]; then
                category_action_source_info="(Line: ${BASH_REMATCH[1]})"
            # Check if the direct match came from a linked note representation (within a subtask line or routine name line itself)
            elif [[ "$category_action_found" =~ \(\(from\ \[\[([^]]+)\]\]\)\) ]]; then
                category_action_source_info="from [[${BASH_REMATCH[1]}]]"
            fi
        fi
    elif [[ "$item_to_consider" =~ \(\(from\ \[\[([^]]+)\]\]\)\)\ (Line:\ ([0-9]+)\) ]]; then
        # This item is a representation of a linked note from a subtask, so search inside the actual file
        note_name="${BASH_REMATCH[1]}"
        subtask_source_line="${BASH_REMATCH[2]}" # This is the line number where the link was found in the daily journal, not the linked note itself.
        
        # Find the linked Markdown file within the Obsidian vault.
        # Using find with -maxdepth 5 to prevent infinite loops in complex symlinked vaults, adjust if needed.
        linked_file_path=$(find "$OBSIDIAN_VAULT_PATH" -type f -iname "${note_name}.md" -print -quit 2>/dev/null)
        
        if [ -n "$linked_file_path" ]; then
            # Grep for #CategoryOrAction in the linked file. -m 1 exits after first match.
            # Capture line number from grep as well.
            found_in_linked_note_with_line=$(grep -m 1 -n "#CategoryOrAction" "$linked_file_path" 2>/dev/null)
            
            if [ -n "$found_in_linked_note_with_line" ]; then
                # Extract line number and content from grep output (e.g., "5:  - Task from linked note #CategoryOrAction")
                linked_note_line_num=$(echo "$found_in_linked_note_with_line" | cut -d: -f1)
                linked_note_content=$(echo "$found_in_linked_note_with_line" | cut -d: -f2-)
                
                # Append the original "((from [[note]])) (Line: DailyJournalLineNum)" part to the found action for clarity
                full_found_item="${linked_note_content} ((from [[${note_name}]]) (Line in Linked Note: $linked_note_line_num))"
                
                if [[ ! -v temp_unique_found_category_actions_map["$full_found_item"] ]]; then
                    found_category_actions_list+=("$full_found_item")
                    temp_unique_found_category_actions_map["$full_found_item"]=1
                fi

                # If no category_action_found yet, set this one as the primary
                if [ -z "$category_action_found" ]; then
                    category_action_found="$full_found_item"
                    category_action_source_info="from [[${note_name}]] (Line: $linked_note_line_num)"
                fi
            fi
        fi
    elif [[ "$item_to_consider" =~ \(\(from\ \[\[([^]]+)\]\]\)\) ]]; then
        # This item is a representation of a linked note from a routine name, so search inside the actual file
        note_name="${BASH_REMATCH[1]}"
        
        # Find the linked Markdown file within the Obsidian vault.
        linked_file_path=$(find "$OBSIDIAN_VAULT_PATH" -type f -iname "${note_name}.md" -print -quit 2>/dev/null)
        
        if [ -n "$linked_file_path" ]; then
            # Grep for #CategoryOrAction in the linked file. -m 1 exits after first match.
            found_in_linked_note_with_line=$(grep -m 1 -n "#CategoryOrAction" "$linked_file_path" 2>/dev/null)
            
            if [ -n "$found_in_linked_note_with_line" ]; then
                linked_note_line_num=$(echo "$found_in_linked_note_with_line" | cut -d: -f1)
                linked_note_content=$(echo "$found_in_linked_note_with_line" | cut -d: -f2-)

                full_found_item="${linked_note_content} ((from [[${note_name}]]) (Line in Linked Note: $linked_note_line_num))"
                
                if [[ ! -v temp_unique_found_category_actions_map["$full_found_item"] ]]; then
                    found_category_actions_list+=("$full_found_item")
                    temp_unique_found_category_actions_map["$full_found_item"]=1
                fi

                if [ -z "$category_action_found" ]; then
                    category_action_found="$full_found_item"
                    category_action_source_info="from [[${note_name}]] (Line: $linked_note_line_num)"
                fi
            fi
        fi
    fi
done

# Prepare the category/action display header and content based on whether an action was found.
category_action_display_header=""
category_action_display_content=""

if [ -n "$category_action_found" ]; then
    # Clean up the found action item by removing #CategoryOrAction tag and leading list markers,
    # and also remove the ((from [[note]])) part for the main display, keep it for quick result.
    # Updated sed to handle different source info formats
    cleaned_category_action=$(echo "$category_action_found" | sed -E 's/\s*\#CategoryOrAction//g; s/^\s*[-*] \[.?\]\s*//g; s/^\s*[-*]\s*//g; s/^\s*[0-9]+\.\s*//g; s/\s*\(\(from\ \[\[[^]]+\]\]\)\s*(\(Line\ in\ Linked\ Note:\ [0-9]+\)\)*|\(Line:\ [0-9]+\)\s*\)*//g' | xargs)
    
    # Construct the dynamic header including the source note if available
    if [ -n "$category_action_source_info" ]; then
        category_action_display_header="✨ YOUR CURRENT CATEGORY/ACTION ($category_action_source_info) :"
    else
        category_action_display_header="✨ YOUR CURRENT CATEGORY/ACTION :"
    fi
    
    category_action_display_content="$cleaned_category_action"
    quick_result_category_action="$cleaned_category_action" # Set for quick result section
else
    category_action_display_header="✨ YOUR CURRENT CATEGORY/ACTION (No category/action identified with '#CategoryOrAction' tag.) :"
    category_action_display_content="NONE"
    quick_result_category_action="NONE" # Set for quick result section
fi

# Helper function for printing grouped lists within the consideration section
# It takes the header and a list of items as arguments
print_grouped_list() {
    local header="$1"
    shift
    local items_str="$1" # Expecting a newline-separated string
    
    output_content+="    ➡️ **$header**\n"
    if [ -n "$items_str" ]; then
        # Convert newline-separated string back to array for processing
        IFS=$'\n' read -r -d '' -a items_array <<< "$items_str"
        # Use a temporary associative array for uniqueness within THIS specific group's display
        declare -A unique_map
        for item in "${items_array[@]}"; do
            unique_map["$item"]=1
        done
        for item in "${!unique_map[@]}"; do
            output_content+="        - $item\n"
        done
    else
        output_content+="        (NONE)\n"
    fi
}

# Append "CONSIDERED LIST FOR CATEGORY OR ACTION" section with grouping.
if [ ${#matched_routines_with_lines[@]} -gt 0 ]; then
    for routine_item_with_line in "${matched_routines_with_lines[@]}"; do
        IFS='|' read -r routine_line_num routine_description <<< "$routine_item_with_line"
        output_content+="✨ CRITICAL REVISION: CONSIDERED LIST FOR ${routine_description} (Line: ${routine_line_num}):\n"
        output_content+="----------------------------------------\n"

        # Retrieve items from the map for this specific routine
        local linked_from_name_items="${routine_consideration_items_map["${routine_description}|${routine_line_num}_linked_from_name"]}"
        local subtask_items="${routine_consideration_items_map["${routine_description}|${routine_line_num}_subtasks"]}"
        local linked_from_subtasks_items="${routine_consideration_items_map["${routine_description}|${routine_line_num}_linked_from_subtasks"]}"

        # Combine linked notes for display
        local all_linked_notes_for_display=""
        if [ -n "$linked_from_name_items" ]; then
            all_linked_notes_for_display+="$linked_from_name_items"
        fi
        if [ -n "$linked_from_subtasks_items" ]; then
            if [ -n "$all_linked_notes_for_display" ]; then
                all_linked_notes_for_display+=$'\n'
            fi
            all_linked_notes_for_display+="$linked_from_subtasks_items"
        fi

        # Display groups, using NONE if empty
        print_grouped_list "Linked Notes" "$all_linked_notes_for_display"
        print_grouped_list "Subtasks" "$subtask_items"
        
        output_content+="\n"
    done
else
    output_content+="✨ CRITICAL REVISION: CONSIDERED LISTS (No active routines, so no lists to consider.)\n"
    output_content+="----------------------------------------\n"
    output_content+="    (NONE)\n"
    output_content+="\n"
fi


# --- Check for Duplicate #CategoryOrAction Tags ---
output_content+="🔍 DUPLICATE #CategoryOrAction TAGS CHECK:\n"
output_content+="----------------------------------------\n"

if [ ${#found_category_actions_list[@]} -gt 1 ]; then
    output_content+="    ❌ Multiple instances of #CategoryOrAction were found!\n"
    output_content+="    Please ensure only one #CategoryOrAction is active at a time.\n"
    output_content+="    Found #CategoryOrAction tags in the following items (in order of discovery):\n"
    for action_item in "${found_category_actions_list[@]}"; do
        output_content+="        - $action_item\n"
    done
else
    output_content+="    ✅ No duplicate #CategoryOrAction tags found. Only one (or zero) active #CategoryOrAction.\n"
fi
output_content+="\n"


# Append "CATEGORY/ACTION" with the new, dynamic format.
output_content+="$category_action_display_header\n"
output_content+="----------------------------------------\n"
output_content+="$category_action_display_content\n"
output_content+="--------------------------------------------------------\n"

# Append final logging information.
output_content+="🏁 FINAL CONCLUSION\n"
output_content+="--------------------------------------------------------\n"
output_content+="Script finished at $(date)\n"
output_content+="Output captured in: $(pwd)/$OUTPUT_FILE\n"
output_content+="--------------------------------------------------------\n"

# --- Final Print to STDOUT and File ---
# Construct the final output string with QUICK RESULT at the top, followed by the main content.
final_combined_output="🚀 QUICK RESULT\n"
final_combined_output+="$quick_result_routine_name\n"
final_combined_output+="$quick_result_category_action\n"
final_combined_output+="--------------------------------------------------------\n"
final_combined_output+="$output_content"

echo -e "$final_combined_output" > "$OUTPUT_FILE"
echo -e "$final_combined_output"
