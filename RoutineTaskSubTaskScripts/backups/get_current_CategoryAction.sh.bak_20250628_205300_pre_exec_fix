#!/bin/bash

# --- Diagnostic Line ---
# This line will help us understand which shell is actually running this script.
echo "Running with SHELL: $0, BASH_VERSION: $BASH_VERSION"
# --- End Diagnostic Line ---

# Get the current date in Букмекерлар-MM-DD format
current_date=$(date +%Y-%m-%d)

# Define the planner file name using the current date variable
# Ensure this path is correct for your daily journal files
PLANNER_FILE="/home/aditya/obsidian/All Things/Journal/Daily Journal/${current_date}.md"

# Define the root path to your Obsidian vault
# This is crucial for searching linked notes
OBSIDIAN_VAULT_PATH="/home/aditya/obsidian"

# Define a static output file name. This file will store the script's output.
OUTPUT_FILE="current_routine.txt"

# --- Variables to store data for QuickResult ---
# These variables will store the final quick result values to be used in the combined output.
quick_result_routine_name=""
quick_result_category_action=""
# --- End QuickResult variables ---

# Initialize output_content string that will accumulate all parts of the output *after* the quick result.
output_content=""

# Get the current hour and minute for time-based routine matching
current_hour=$(date +%H)
current_minute=$(date +%M)

# Convert current time to total minutes from midnight for easy comparison
current_total_minutes=$((10#$current_hour * 60 + 10#$current_minute))

# Check if today's planner file exists. If not, populate error content and set quick result values, then exit.
if [ ! -f "$PLANNER_FILE" ]; then
    output_content+="--------------------------------------------------------\n"
    output_content+="Starting Routine, Action List, and Category/Action retrieval for $current_date at $(date)\n"
    output_content+="--------------------------------------------------------\n"
    output_content+="Error: Planner file '$PLANNER_FILE' not found. Please ensure your daily journal is in the specified path.\n"
    output_content+="--------------------------------------------------------\n"

    quick_result_routine_name="No Active Routine" # Set for quick result section
    quick_result_category_action="NONE" # Set for quick result section

    # Ensure to also print the final output location even on early exit
    output_content+="Script finished at $(date)\n"
    output_content+="Output captured in: $(pwd)/$OUTPUT_FILE\n"

    # --- Final Print to STDOUT and File (for early exit) ---
    # This block now prepares the quick result and combines it with output_content for unified print.
    final_combined_output="QUICK RESULT\n"
    final_combined_output+="$quick_result_routine_name\n"
    final_combined_output+="$quick_result_category_action\n"
    final_combined_output+="--------------------------------------------------------\n"
    final_combined_output+="$output_content"

    echo -e "$final_combined_output" > "$OUTPUT_FILE"
    echo -e "$final_combined_output"

    exit 1
fi

# Append initial logging information (This comes *after* the quick result, so no quick result data here).
output_content+="INFORMATION ABOUT THE SCRIPT\n"
output_content+="--------------------------------------------------------\n"
output_content+="Starting Routine, Action List, and Category/Action retrieval for $current_date at $(date)\n"
output_content+="Planner file processed: $PLANNER_FILE\n"
output_content+="--------------------------------------------------------\n"

# Initialize an empty array to store all matched routine descriptions along with their line numbers.
matched_routines_with_lines=()
line_num=0 # Counter for current line number in the planner file

# Loop through the planner file line by line to identify active routines.
while IFS= read -r line || [[ -n "$line" ]]; do
    line_num=$((line_num + 1))
    # Store the current line content for subtask/linked note processing
    current_line_content="$line"

    # Check if the line contains a time pattern (e.g., "HH:MM - HH:MM")
    if [[ "$line" =~ ([0-9]{2}:[0-9]{2})\ -\ ([0-9]{2}:[0-9]{2}) ]]; then
        start_time_str="${BASH_REMATCH[1]}" # Capture start time (e.g., "08:00")
        end_time_str="${BASH_REMATCH[2]}"   # Capture end time (e.g., "09:00")

        # Extract the routine description by removing the time pattern and leading bullet/checkbox.
        routine_description_raw="${line#*- \[ \] }"
        routine_description_final=$(echo "$routine_description_raw" | sed -E 's/\s*([0-9]{2}:[0-9]{2})\s*-\s*([0-9]{2}:[0-9]{2})\s*//' | xargs)

        # Parse start and end times into hour and minute components.
        start_hour=${start_time_str%:*}
        start_minute=${start_time_str#*:}
        end_hour=${end_time_str%:*}
        end_minute=${end_time_str#*:}

        # Convert routine start and end times to total minutes from midnight for comparison.
        # Fixed: Use start_minute for start_total_minutes, not current_minute.
        start_total_minutes=$((10#$start_hour * 60 + 10#$start_minute))
        end_total_minutes=$((10#$end_hour * 60 + 10#$end_minute))

        # Check if the current system time falls within the routine's time slot.
        # This condition handles routines that cross midnight (e.g., 23:00 - 02:00).
        if (( current_total_minutes >= start_total_minutes && current_total_minutes < end_total_minutes )) || \
           ( (( end_total_minutes < start_total_minutes )) && \
             ( (current_total_minutes >= start_total_minutes) || (current_total_minutes < end_total_minutes) ) ) ; then

            # If the routine is active, add its description and line number to the array.
            matched_routines_with_lines+=("${line_num}|${routine_description_final}")
        fi
    fi
done < "$PLANNER_FILE"

# Initialize new arrays for grouped consideration list items
# These will be populated per routine and then used for the combined search
# (moved outside loop to store all for combined search)
linked_notes_from_routine_name_items_all=()
direct_subtask_items_all=()
linked_notes_from_subtasks_items_all=()

# Initialize an associative array to store consideration items per routine for grouped display
declare -A routine_consideration_items_map

# Process the identified active routines to extract their associated action list items.
if [ ${#matched_routines_with_lines[@]} -gt 0 ]; then
    output_content+="ROUTINE DECLARATION\n"
    output_content+="----------------------------------------\n"

    # Populate quick_result_routine_name_parts for quick result section
    quick_result_routine_name_parts=()

    for routine_item_with_line in "${matched_routines_with_lines[@]}"; do
        IFS='|' read -r routine_line_num routine_description <<< "$routine_item_with_line"
        output_content+="- $routine_description (Line: $routine_line_num)\n"
        quick_result_routine_name_parts+=("$routine_description")

        # New: Collect linked notes from routine name for *this specific routine's* consideration list
        declare -a current_routine_linked_notes_from_name=()
        if [[ "$routine_description" =~ \[\[([^]]+)\]\] ]]; then
            linked_note_from_routine="${BASH_REMATCH[1]}"
            current_routine_linked_notes_from_name+=("((from [[${linked_note_from_routine}]]) (Line: $routine_line_num))") # Indicate source
            linked_notes_from_routine_name_items_all+=("((from [[${linked_note_from_routine}]]) (Line: $routine_line_num))") # Add to overall list for search
        fi

        # Find associated action list items for the current routine.
        # This searches for lines immediately following the routine line that are indented
        # and contain a checkbox, stopping at the next unindented line or routine line.
        current_routine_found_consideration_items=() # Stores items for *this* routine's consideration list

        # Use awk to parse the relevant section of the file for subtasks and linked notes
        # Start from the routine's line number + 1, and process until an unindented line is found
        # or another routine line is found.
        awk_script='
            BEGIN {
                in_routine_block = 0;
                routine_indent = -1;
                linked_notes_from_subtasks_found = "";
            }
            NR == start_line_num {
                in_routine_block = 1;
                # Determine the indentation of the routine line itself
                match($0, /^[[:space:]]*/);
                routine_indent = RLENGTH;
                next; # Skip the routine line itself
            }
            in_routine_block == 1 {
                # Get current line content
                current_line_content = $0;

                # Get the leading spaces (indentation) of the current line
                match(current_line_content, /^[[:space:]]*/);
                current_indent = RLENGTH;

                # If the current line is less indented than the routine or a new routine, stop processing for this block
                if (current_indent <= routine_indent && current_indent != 0 && NR != start_line_num) {
                    in_routine_block = 0;
                    exit; # Stop processing this awk call for this routine
                }
                
                # Check if line is empty or just whitespace, then skip
                if (current_line_content ~ /^[[:space:]]*$/) {
                    next;
                }

                # Check if it is a subtask with a checkbox (e.g., "- [ ] Subtask")
                if (current_line_content ~ /^[[:space:]]*- \[ \] /) {
                    # Extract linked notes from subtasks
                    while (match(current_line_content, /\\[\\[([^\\]]+)\\]\\]/)) {
                        linked_note = substr(current_line_content, RSTART+2, RLENGTH-4);
                        printf "((from %s) (Line: %s))\n", linked_note, NR; # Output linked note
                        linked_notes_from_subtasks_found = linked_notes_from_subtasks_found "((from [[" linked_note "]]) (Line: " NR "))\n";
                        sub(/\\[\\[([^\\]]+)\\]\\]/, "", current_line_content); # Remove matched part to find next
                    }
                }
            }
            END {
                printf "%s", linked_notes_from_subtasks_found;
            }
        ' start_line_num="$routine_line_num" "$PLANNER_FILE" | while IFS= read -r linked_note_item; do
            if [[ -n "$linked_note_item" ]]; then
                linked_notes_from_subtasks_items_all+=("$linked_note_item")
                current_routine_found_consideration_items+=("$linked_note_item") # Add to current routine's list
            fi
        done

        # Store the current routine's consideration items in the map
        routine_consideration_items_map["$routine_description"]=$(printf "%s\n" "${current_routine_linked_notes_from_name[@]}" "${current_routine_found_consideration_items[@]}")

    done
    output_content+="\n"

    # Append all consideration items for display
    output_content+="CRITICAL REVISION: CONSIDERED LISTS\n"
    output_content+="--------------------------------------------------------\n"
    # Display grouped consideration items for each routine
    for routine_desc in "${!routine_consideration_items_map[@]}"; do
        consideration_items="${routine_consideration_items_map[$routine_desc]}"
        if [[ -n "$consideration_items" ]]; then
            output_content+="- For Routine: '$routine_desc'\n"
            while IFS= read -r item; do
                if [[ -n "$item" ]]; then
                    output_content+="  - $item\n"
                fi
            done <<< "$consideration_items"
        fi
    done
    output_content+="\n"

else
    output_content+="ROUTINE DECLARATION\n"
    output_content+="----------------------------------------\n"
    output_content+="No active routines found for the current time.\n"
    output_content+="\n"
    quick_result_routine_name="No Active Routine" # Set for quick result section
    output_content+="CRITICAL REVISION: CONSIDERED LISTS (No active routines, so no lists to consider.)\n"
    output_content+="\n"
fi


# --- CATEGORY/ACTION SECTION ---
# Initialize variables for the category/action section
active_category_action_line_num=""
active_category_action_content=""
found_category_actions_list=() # To check for duplicates

# Search for the #CategoryOrAction tag within the identified routines' subtasks and linked notes.
# Prioritize linked notes from routine names, then linked notes from subtasks, then direct subtasks.

# Combine all lists for a comprehensive search for #CategoryOrAction
all_consideration_items=("${linked_notes_from_routine_name_items_all[@]}" "${linked_notes_from_subtasks_items_all[@]}" "${direct_subtask_items_all[@]}")

# Filter for unique items before processing for tags
declare -A unique_all_consideration_items_map
for item in "${all_consideration_items[@]}"; do
    unique_all_consideration_items_map["$item"]=1
done

# Process unique items to find the #CategoryOrAction tag
for item_content in "${!unique_all_consideration_items_map[@]}"; do
    # Regex to find #CategoryOrAction tag
    if [[ "$item_content" =~ \#CategoryOrAction ]]; then
        # Extract the line number if available
        line_num_match=$(echo "$item_content" | grep -oP '\(Line: \K[0-9]+')
        if [[ -n "$line_num_match" ]]; then
            active_category_action_line_num="$line_num_match"
        fi
        
        # Extract the content before the tag for display
        # Remove the "((from ...)) (Line: ...))" part to get the clean action
        clean_action_content=$(echo "$item_content" | sed -E 's/\(\(from \[\[[^]]+\]\]\)\)\s*(\(Line: [0-9]+\))?//g' | sed 's/#CategoryOrAction//g' | xargs)
        found_category_actions_list+=("$clean_action_content")
    fi
done

# Prepare the display content for category/action
category_action_display_header=""
category_action_display_content=""

if [ ${#found_category_actions_list[@]} -gt 0 ]; then
    if [ ${#found_category_actions_list[@]} -eq 1 ]; then
        quick_result_category_action="${found_category_actions_list[0]}" # Set for quick result
        category_action_display_header="YOUR CURRENT CATEGORY/ACTION (Line: $active_category_action_line_num) :"
        category_action_display_content="${found_category_actions_list[0]}"
    else
        # Multiple #CategoryOrAction tags found, show all.
        quick_result_category_action="MULTIPLE FOUND" # Set for quick result
        category_action_display_header="YOUR CURRENT CATEGORY/ACTION (MULTIPLE FOUND - PLEASE CHECK) :"
        category_action_display_content="Multiple #CategoryOrAction tags were found. Please ensure only one is active at a time. Found:"
        for action_item in "${found_category_actions_list[@]}"; do
            category_action_display_content+="\n- $action_item"
        done
    fi
else
    quick_result_category_action="NONE" # Set for quick result
    category_action_display_header="YOUR CURRENT CATEGORY/ACTION :"
    category_action_display_content="No active category/action identified with '#CategoryOrAction' tag."
fi


# --- DUPLICATE #CategoryOrAction TAGS CHECK ---
output_content+="DUPLICATE #CategoryOrAction TAGS CHECK:\n"
output_content+="--------------------------------------------------------\n"

if [ ${#found_category_actions_list[@]} -gt 1 ]; then
    output_content+="    Multiple instances of #CategoryOrAction were found! Please ensure only one is active at a time.\n"
    output_content+="    Found #CategoryOrAction tags in the following items (in order of discovery):\n"
    # Use an associative array to print unique found_category_actions_list items
    declare -A unique_found_actions_map
    for action_item in "${found_category_actions_list[@]}"; do
        unique_found_actions_map["$action_item"]=1
    done
    for action_item in "${!unique_found_actions_map[@]}"; do
        output_content+="        - $action_item\n"
    done
else
    output_content+="    No duplicate #CategoryOrAction tags found. Only one (or zero) active #CategoryOrAction.\n"
fi
output_content+="\n"


# Append "CATEGORY/ACTION" with the new, dynamic format.
output_content+="$category_action_display_header\n"
output_content+="----------------------------------------\n"
output_content+="$category_action_display_content\n"
output_content+="--------------------------------------------------------\n"

# Append final logging information.
output_content+="FINAL CONCLUSION\n"
output_content+="--------------------------------------------------------\n"
output_content+="Script finished at $(date)\n"
output_content+="Output captured in: $(pwd)/$OUTPUT_FILE\n"
output_content+="--------------------------------------------------------\n"

# --- Final Print to STDOUT and File ---
# Construct the final output string with QUICK RESULT at the top, followed by the main content.
final_combined_output="QUICK RESULT\n"
final_combined_output+="$quick_result_routine_name\n"
final_combined_output+="$quick_result_category_action\n"
final_combined_output+="--------------------------------------------------------\n"
final_combined_output+="$output_content"

echo -e "$final_combined_output" > "$OUTPUT_FILE"
echo -e "$final_combined_output"
