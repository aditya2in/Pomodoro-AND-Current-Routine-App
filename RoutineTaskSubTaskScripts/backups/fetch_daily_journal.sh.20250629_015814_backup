#!/bin/bash

# fetch_daily_journal.sh: Fetches and displays today's daily journal entry from Obsidian.
# Located in: /home/aditya/dotfiles/POMODORO-CLI/.config/pomodoro_cli/RoutineTaskSubTaskScripts
# Output is saved to: current_routine.txt in the same directory as this script.

# --- Script Configuration ---
# Get the current date in Букмекерлар-MM-DD format (e.g., 2025-06-28)
current_date=$(date +%Y-%m-%d)

# Define the base directory for your daily journal files
# IMPORTANT: Verify this path matches your Obsidian vault's Daily Journal folder.
JOURNAL_DIR="/home/aditya/obsidian/All Things/Journal/Daily Journal"

# Define the full path to today's planner file
PLANNER_FILE="${JOURNAL_DIR}/${current_date}.md"

# Determine the directory where this script is located
# dirname "$(readlink -f "$0")": Gets the absolute path of the directory containing the script.
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

# Define the full path to the output log file, placed in the same directory as the script
OUTPUT_LOG_FILE="${SCRIPT_DIR}/current_routine.txt"

# NEW CONFIGURATION: Control whether the "All File Content" section is displayed.
# Set to "true" to display the entire journal file content, "false" to hide it.
ENABLE_ALL_FILE_CONTENT_SECTION="true"

# Variable to store the quick result, initialized to a default message.
# This will be placed at the very top of the output file.
