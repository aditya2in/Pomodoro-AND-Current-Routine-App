current_routine_line_to_color=""

# NEW GLOBAL ARRAYS: To store all active routines found
declare -a GLOBAL_ACTIVE_ROUTINE_LINES # Stores line numbers of all active routines
declare -a GLOBAL_ACTIVE_ROUTINE_DESCRIPTIONS # Stores descriptions of all active routines

# --- ANSI Color Codes ---
GREEN='\e[0;32m'
BLUE='\e[0;34m'
CYAN='\e[0;36m'
YELLOW='\e[1;33m' # Bold Yellow
MAGENTA='\e[0;35m'
RED='\e[0;31m'
NC='\e[0m' # No Color (reset)

# ANSI Color Codes for specific highlighting
RED_COLOR='\e[0;31m' # Red color for highlighting
NC_COLOR='\e[0m'     # No Color (reset)

# --- Helper Functions ---

# Function to clear the output file at the very first log_output call
# and then append for subsequent calls.
log_and_tee() {
    if [ ! -f "${SCRIPT_DIR}/.log_init_marker" ]; then
        echo -n > "$OUTPUT_LOG_FILE" # Clear the file
        touch "${SCRIPT_DIR}/.log_init_marker" # Mark as initialized
    fi
    echo -e "$@" | tee -a "$OUTPUT_LOG_FILE" # Use -e for ANSI color interpretation
}

# Function to get the display width of a string, ignoring ANSI escape codes.
get_display_width() {
    # Remove ANSI escape codes and then calculate string length.
    # This sed command removes common ANSI color/bold/reset codes.
    local stripped_string=$(echo -e "$1" | sed -E "s/\x1B\[([0-9]{1,2}(;[0-9]{1,2})?)?[mGK]//g")
    echo "${#stripped_string}"
}

# Function to draw a visually appealing box around a given string.
# $1: The string to be enclosed in the box. This string can contain ANSI codes.
draw_routine_box() {
    local content="$1"
    local padding_sides=4 # 2 spaces on each side for the content itself inside the box
    local box_line_padding="  " # Padding for left and right inside the box line

    # Calculate the visible width of the content, ignoring ANSI escape codes
    local content_display_width=$(get_display_width "$content")

    # The total width of the box for the horizontal lines (excluding corners)
    # This includes the content width plus the internal padding on both sides
    local horizontal_line_width=$((content_display_width + (2 * ${#box_line_padding})))

    # Top border
    log_and_tee "${CYAN}╭$(printf '─%.0s' $(seq 1 $horizontal_line_width))╮${NC}"

    # Content line
    # We explicitly calculate the spaces on the right to make sure it aligns correctly
    local spaces_needed_right=$((horizontal_line_width - content_display_width - ${#box_line_padding}))
    log_and_tee "${CYAN}│${box_line_padding}${content}${NC}$(printf ' %.0s' $(seq 1 $spaces_needed_right))${CYAN}│${NC}"

    # Bottom border
    log_and_tee "${CYAN}╰$(printf '─%.0s' $(seq 1 $horizontal_line_width))╯${NC}"
}

# NEW FUNCTION: Perform an early scan of the journal file to find the active routine
# and set global variables for line coloring and quick result.
find_active_routine() {
    # Local variables for this function's scope; GLOBAL_ACTIVE_ROUTINE_LINES and _DESCRIPTIONS are global
    GLOBAL_ACTIVE_ROUTINE_LINES=() # Clear array on each call
    GLOBAL_ACTIVE_ROUTINE_DESCRIPTIONS=() # Clear array on each call
    local temp_routine_line_number=""
    local temp_routine_description=""

    # Get current hour and minute
    local current_hour=$(date +%H)
    local current_minute=$(date +%M)
    local current_time_in_minutes=$((10#$current_hour * 60 + 10#$current_minute))

    # Check if the journal file exists before trying to read it
    if [ ! -f "$PLANNER_FILE" ]; then
        log_and_tee "⚠️ Warning: Journal file '$PLANNER_FILE' not found during early routine scan."
        # If file not found, no routine can be active. Global variables remain default.
        return
    fi

    local current_file_line_num=0 # NEW: Initialize line counter for the file
    # Read the content of the journal file and find time patterns
    while IFS= read -r line; do
        current_file_line_num=$((current_file_line_num + 1)) # Increment line number for each line read

        # MODIFIED REGEX: More robust for space variations and captures the full routine text
        # This regex now captures:
        # BASH_REMATCH[1]: The part before the first timestamp (e.g., "- [ ] Shri Karthikeya ")
        # BASH_REMATCH[2]: Start time (e.g., "00:10")
        # BASH_REMATCH[3]: End time (e.g., "03:00")
        if [[ "$line" =~ (.*)([0-9]{2}:[0-9]{2})[[:space:]]*-?[[:space:]]?([0-9]{2}:[0-9]{2}) ]]; then
            local routine_prefix_and_text="${BASH_REMATCH[1]}"
            local start_time_str="${BASH_REMATCH[2]}"
            local end_time_str="${BASH_REMATCH[3]}"

            # MODIFIED LINE: Extract the pure description by removing common prefixes like "- [ ] "
            # and then trimming any remaining whitespace.
            local routine_description=$(echo "$routine_prefix_and_text" | sed -E 's/^[[:space:]]*- ?\[ ?\] ?//' | sed -E 's/^\*\*[^:]*:\*\* ?//' | xargs)

            local start_hour=$(echo "$start_time_str" | cut -d':' -f1)
            local start_minute=$(echo "$start_time_str" | cut -d':' -f2)
            local end_hour=$(echo "$end_time_str" | cut -d':' -f1)
            local end_minute=$(echo "$end_time_str" | cut -d':' -f2)

            local start_time_in_minutes=$((10#$start_hour * 60 + 10#$start_minute))
            local end_time_in_minutes=$((10#$end_hour * 60 + 10#$end_minute))

            # Check if current time falls within the routine's schedule
            if (( start_time_in_minutes > end_time_in_minutes )); then
                # Routine spans midnight (e.g., 23:00 - 02:00)
                if (( current_time_in_minutes >= start_time_in_minutes || current_time_in_minutes < end_time_in_minutes )); then
                    GLOBAL_ACTIVE_ROUTINE_LINES+=("$current_file_line_num") # Use the current line number
                    GLOBAL_ACTIVE_ROUTINE_DESCRIPTIONS+=("$routine_description")
                fi
            else
                # Routine within the same day (e.g., 09:00 - 17:00)
                if (( current_time_in_minutes >= start_time_in_minutes && current_time_in_minutes < end_time_in_minutes )); then
                    GLOBAL_ACTIVE_ROUTINE_LINES+=("$current_file_line_num") # Use the current line number
                    GLOBAL_ACTIVE_ROUTINE_DESCRIPTIONS+=("$routine_description")
                fi
            fi
        fi
    done < "$PLANNER_FILE"

    # Determine current_routine_found based on collected routines
    if [ ${#GLOBAL_ACTIVE_ROUTINE_LINES[@]} -gt 0 ]; then
        export current_routine_found="true"
        # Construct QUICK_RESULT_CONTENT based on all found routines
        if [ ${#GLOBAL_ACTIVE_ROUTINE_DESCRIPTIONS[@]} -eq 1 ]; then
            export QUICK_RESULT_CONTENT="${GLOBAL_ACTIVE_ROUTINE_DESCRIPTIONS[0]}"
        else
            local merged_description=""
            for i in "${!GLOBAL_ACTIVE_ROUTINE_DESCRIPTIONS[@]}"; do
                if [ "$i" -eq 0 ]; then
                    merged_description="${GLOBAL_ACTIVE_ROUTINE_DESCRIPTIONS[$i]}"
                elif [ "$i" -eq $(( ${#GLOBAL_ACTIVE_ROUTINE_DESCRIPTIONS[@]} - 1 )) ]; then
                    merged_description+=" AND ${GLOBAL_ACTIVE_ROUTINE_DESCRIPTIONS[$i]}"
                else
                    merged_description+=", ${GLOBAL_ACTIVE_ROUTINE_DESCRIPTIONS[$i]}"
                fi
            done
            export QUICK_RESULT_CONTENT="$merged_description"
        fi
    else
        export current_routine_found="false"
        export QUICK_RESULT_CONTENT="No active routine found."
    fi
}

# NEW FUNCTION: Extracts all indented lines (subtasks) following a given line number.
get_subtasks_for_routine() {
    local start_line=$1
    local file=$2
    local subtasks=()
    local routine_indentation=""
    local current_line_number=0 # To keep track of lines relative to the start_line for the tail output
    local initial_scan_done=false

    if [ ! -f "$file" ]; then
        echo "Error: File '$file' not found."
        return 1
    fi

    # Read the file line by line to find the starting indentation of the routine
    # and then collect subsequent indented lines.
    # Using 'tail -n +"$start_line"' to start reading from the specified line number
    while IFS= read -r line; do
        current_line_number=$((current_line_number + 1))
        if [ "$current_line_number" -eq 1 ]; then # This is the original routine line itself (first line from tail)
            # Extract the leading whitespace (indentation) of the routine line
            routine_indentation=$(echo "$line" | sed -E 's/^([[:space:]]*).*$/\1/')
            initial_scan_done=true
            continue # Skip the routine line itself, we only need its indentation
        fi

        if "$initial_scan_done"; then
            if [[ "$line" =~ ^[[:space:]]*$ ]]; then # Check for blank lines
                # If a blank line is encountered, stop collecting subtasks.
                # This prevents picking up content from other sections after an empty line.
                break
            fi

            local line_indentation=$(echo "$line" | sed -E 's/^([[:space:]]*).*$/\1/')
            # Check if the line is indented more than the routine's starting indentation
            if [ ${#line_indentation} -gt ${#routine_indentation} ]; then
                # MODIFIED: Only break if it's a new heading, not just any new checkbox item
                if [[ "$line" =~ ^[[:space:]]*[#]+[[:space:]] ]]; then
                    break # Stop if we encounter a new heading
                fi
                subtasks+=("$line") # Add the line as a subtask
            else
                # If indentation is less than or equal to the routine's, stop collecting.
                # This means we've moved out of the current routine's subtask block.
                break
            fi
        fi
    done < <(tail -n +"$start_line" "$file") # Start reading from the routine's line (1-indexed for tail)

    # Join array elements with newlines for output
    if [ ${#subtasks[@]} -gt 0 ]; then
        printf "%s\n" "${subtasks[@]}"
    fi
}


