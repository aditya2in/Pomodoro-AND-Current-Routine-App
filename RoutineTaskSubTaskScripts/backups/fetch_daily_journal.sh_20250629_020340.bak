#!/bin/bash

# fetch_daily_journal.sh: Fetches and displays today's daily journal entry from Obsidian.
# Located in: /home/aditya/dotfiles/POMODORO-CLI/.config/pomodoro_cli/RoutineTaskSubTaskScripts
# Output is saved to: current_routine.txt in the same directory as this script.

# --- Script Configuration ---
# Get the current date in Букмекерлар-MM-DD format (e.g., 2025-06-28)
current_date=$(date +%Y-%m-%d)

# Define the base directory for your daily journal files
# IMPORTANT: Verify this path matches your Obsidian vault's Daily Journal folder.
JOURNAL_DIR="/home/aditya/obsidian/All Things/Journal/Daily Journal"

# Define the full path to today's planner file
PLANNER_FILE="${JOURNAL_DIR}/${current_date}.md"

# Determine the directory where this script is located
# dirname "$(readlink -f "$0")": Gets the absolute path of the directory containing the script.
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

# Define the full path to the output log file, placed in the same directory as the script
OUTPUT_LOG_FILE="${SCRIPT_DIR}/current_routine.txt"

# NEW CONFIGURATION: Control whether the "All File Content" section is displayed.
# Set to "true" to display the entire journal file content, "false" to hide it.
ENABLE_ALL_FILE_CONTENT_SECTION="true"

# Variable to store the quick result, initialized to a default message.
# This will be placed at the very top of the output file.
QUICK_RESULT_CONTENT="No routine found or processed." # Default quick result content

# --- ANSI Color Codes (for better readability in terminal output) ---
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m' # No Color
ORANGE='\033[1;33m' # A vibrant orange for headings

# --- Logging Function ---
# This function logs messages to the output file and also tees them to standard output.
log_and_tee() {
    local message="$1"
    echo -e "$message" | tee -a "$OUTPUT_LOG_FILE"
}

# --- Script Start ---
# Clear the previous log file content at the beginning of each run
> "$OUTPUT_LOG_FILE"

log_and_tee "QUICK RESULT" # Placeholder, will be overwritten later
log_and_tee "${QUICK_RESULT_CONTENT}" # Placeholder content for Quick Result
log_and_tee "" # Blank line after quick result for separation

# Capture parsing start time
parsing_start_time=$(date +"%Y-%m-%d %H:%M:%S")

# --- Basic Section ---
log_and_tee "--- Basic Section ---"
log_and_tee "Script Source Path: ${GREEN}$(readlink -f "$0")${NC}"
log_and_tee "Parsing Started At: ${YELLOW}$parsing_start_time${NC}"
log_and_tee "Expected Journal File: ${BLUE}$PLANNER_FILE${NC}"
log_and_tee "Output Log File: ${BLUE}$OUTPUT_LOG_FILE${NC}"
log_and_tee "Display All File Content: ${GREEN}$ENABLE_ALL_FILE_CONTENT_SECTION${NC}"
log_and_tee "" # Newline for spacing

# Check if today's planner file exists
if [ -f "$PLANNER_FILE" ]; then
    log_and_tee "✅ Found today's journal entry: ${GREEN}$PLANNER_FILE${NC}"
    log_and_tee "" # Newline for spacing

    # --- All File Content (Optional) ---
    if [ "$ENABLE_ALL_FILE_CONTENT_SECTION" = "true" ]; then
        log_and_tee "" # Add a newline for separation
        log_and_tee "--- All File Content ---"
        log_and_tee "" # Newline for spacing
        # Use 'cat -n' to number lines for easy reference
        cat -n "$PLANNER_FILE" | log_and_tee
        log_and_tee "" # Newline for spacing
        log_and_tee "--- End of Journal Entry Content ---"
        log_and_tee "" # Newline for spacing
    fi

    # --- Routine Section ---
    log_and_tee "" # Add a newline for separation
    log_and_tee "--- Routine Scheduled ---"
    log_and_tee "--- Identifying Current Scheduled Routine ---"
    log_and_tee "" # Newline for spacing

    # Define the current time in HH:MM format
    current_time=$(date +"%H:%M")
    # current_time="00:30" # For testing specific times

    # Use awk to find the routine based on current time
    # This awk command looks for lines starting with '- [ ] **NAMES**'
    # and extracts the part of the line that matches the current time.
    # It also extracts the NAME.
    # The output format is "NAME HH:MM-HH:MM"
    # Example: Shri Karthikeya 00:30 - 01:05

    # OLD REGEX for 24-hour format: ([01][0-9]|2[0-3]):[0-5][0-9]\s*-\s*([01][0-9]|2[0-3]):[0-5][0-9]
    # NEW REGEX to match the time format specifically around the "NAMES" task line:
    # We are looking for something like "00:30 - 01:05" at the end of the line
    # The routine name is extracted as the text between "**NAMES** " and the time.

    # Updated awk command to extract the routine name and time for quick result
    ROUTINE_LINE=$(awk -v c_time="$current_time" '
        /^- \[ \] \*\*NAMES\*\*.*[0-9]{2}:[0-9]{2}\s*-\s*[0-9]{2}:[0-9]{2}$/ {
            # Extract the time range from the end of the line
            match($0, /[0-9]{2}:[0-9]{2}\s*-\s*[0-9]{2}:[0-9]{2}/)
            time_range = substr($0, RSTART, RLENGTH)
            start_time_str = substr(time_range, 1, 5)
            end_time_str = substr(time_range, 9, 5) # Assuming " - HH:MM" is 8 chars

            # Convert current time and routine times to minutes for comparison
            split(c_time, ct_arr, ":")
            current_minutes = ct_arr[1] * 60 + ct_arr[2]

            split(start_time_str, st_arr, ":")
            start_minutes = st_arr[1] * 60 + st_arr[2]

            split(end_time_str, et_arr, ":")
            end_minutes = et_arr[1] * 60 + et_arr[2]

            # Adjust end_minutes if it crosses midnight (e.g., 23:00-01:00)
            if (end_minutes < start_minutes) {
                end_minutes += 24 * 60
            }
            # Adjust current_minutes if it's in the next day for comparison with adjusted end_minutes
            if (current_minutes < start_minutes && end_minutes > (24 * 60)) { # THIS IS LINE 131
                current_minutes += 24 * 60
            }


            # Extract the routine name (between **NAMES** and the time)
            # Remove '- [ ] **NAMES** ' from the start
            line_without_prefix = substr($0, length("- [ ] **NAMES** ") + 1)
            # Remove the time range from the end
            sub(/[0-9]{2}:[0-9]{2}\s*-\s*[0-9]{2}:[0-9]{2}$/, "", line_without_prefix)
            # Remove any leading/trailing spaces
            gsub(/^[[:space:]]+|[[:space:]]+$/, "", line_without_prefix)
            # Set the quick result content
            print line_without_prefix # This will be captured by the shell variable
            exit # Exit after finding the first match
        }
    ' "$PLANNER_FILE")

    if [ -n "$ROUTINE_LINE" ]; then
        # The ROUTINE_LINE now contains the extracted name and time (e.g., "Finish a SY clearance cycle once a day  00:30 - 01:05")
        # Let's re-extract just the name for the quick result, if it's desired to be just the name
        ROUTINE_NAME_FOR_QR=$(echo "$ROUTINE_LINE" | sed 's/\s*[0-9]{2}:[0-9]{2}\s*-\s*[0-9]{2}:[0-9]{2}//')
        QUICK_RESULT_CONTENT="$ROUTINE_NAME_FOR_QR" # Set the quick result content

        # Now, extract just the "NAMES" part for the "Considered List" heading
        ROUTINE_NAME=$(echo "$ROUTINE_LINE" | awk -F'\\*\\*NAMES\\*\\* ' '{print $2}' | sed 's/\\s*[0-9][0-9]:[0-9][0-9]\\s*-\\s*[0-9][0-9]:[0-9][0-9]//g' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

        # Log the routine name in a box (re-using the logic from current_routine.txt)
        local box_content="$ROUTINE_NAME"
        local box_width=$((${#box_content} + 4)) # +4 for padding and borders
        printf " ${BLUE}╭%s╮ ${NC}\n" "$(printf '─%.0s' $(seq 1 $box_width))" | log_and_tee
        printf " ${BLUE}│ ${NC}${GREEN}%s${NC} ${BLUE}│ ${NC}\n" "$(printf '%-*s' $box_width "$box_content")" | log_and_tee
        printf " ${BLUE}╰%s╯ ${NC}\n" "$(printf '─%.0s' $(seq 1 $box_width))" | log_and_tee
        log_and_tee "" # Newline for spacing

        log_and_tee " ${ORANGE}--- Considered List for \"$ROUTINE_NAME\" --- ${NC}" # The heading for the considered list
        log_and_tee "👉 **Subtasks:**" # NEW: Subheading for subtasks
        log_and_tee "" # Newline for spacing


        # Extract and display subtasks for the identified routine
        # Find the line number of the routine
        start_line=$(grep -n -m 1 "^\s*-\s*\[ \] \*\*NAMES\*\*.*$ROUTINE_NAME" "$PLANNER_FILE" | cut -d: -f1)

        if [ -n "$start_line" ]; then
            # Find the next routine or a main heading to determine the end of this routine's subtasks
            # This looks for the next line that starts with '- [ ] **NAMES**' or '##' (a new section/heading)
            # or '- [' (another top-level task)
            end_line=$(awk -v start="$start_line" '
                NR > start && (/^- \[ \] \*\*NAMES\*\* / || /^## / || /^- \[ \]/) {
                    print NR
                    exit
                }
                END {
                    if (NR > start && !found_next_heading) {
                        print NR + 1 # If no next heading, go to end of file
                    }
                }
            ' "$PLANNER_FILE")

            # If no end line is found (i.e., this is the last routine in the file), set end_line to file's last line
            if [ -z "$end_line" ]; then
                end_line=$(wc -l < "$PLANNER_FILE")
                end_line=$((end_line + 1)) # Go one past the last line to include all content
            fi


            # Extract lines between start_line and end_line, excluding the routine name line itself
            # and only lines that are indented (subtasks typically are indented with tabs/spaces)
            # and start with '- [' (checkbox items)
            # and are not empty
            awk -v s="$start_line" -v e="$end_line" '
                NR > s && NR < e {
                    # Check if line is indented and is a checkbox item
                    if ($0 ~ /^\s+-\s*\[[ xX]?\] / && $0 !~ /^\s*$/) {
                        # Remove leading whitespace and add bullet point for cleaner output in log
                        gsub(/^[ \t]+/, "", $0);
                        print $0; # Print the subtask line
                    }
                }
            ' "$PLANNER_FILE" | log_and_tee
        else
            log_and_tee "⚠️ Could not find the start line for routine: '$ROUTINE_NAME'"
        fi

        log_and_tee "" # Add a newline for separation
    else
        QUICK_RESULT_CONTENT="No scheduled routine found for the current time." # Update quick result for no routine
        log_and_tee " ${BLUE}╭──────╮ ${NC}" | log_and_tee # Empty box to signify no routine
        log_and_tee " ${BLUE}│  .  ${NC}   ${BLUE}│ ${NC}" | log_and_tee
        log_and_tee " ${BLUE}╰──────╯ ${NC}" | log_and_tee
        log_and_tee "" # Newline for spacing
        log_and_tee " ${ORANGE}--- Considered List for \"\" --- ${NC}" # The heading for an empty considered list
        log_and_tee "    No active routine found for the current time ($current_time)." | log_and_tee # Indented message
        log_and_tee "" # Newline for spacing
    fi
else
    QUICK_RESULT_CONTENT="No journal entry found for today." # Update quick result for no journal
    log_and_tee "❌ Today's journal entry not found: ${RED}$PLANNER_FILE${NC}"
    log_and_tee "" # Newline for spacing
    log_and_tee "--- Routine Scheduled ---"
    log_and_tee "--- Identifying Current Scheduled Routine ---"
    log_and_tee "" # Newline for spacing
    log_and_tee " ${BLUE}╭──────╮ ${NC}" | log_and_tee # Empty box to signify no routine
    log_and_tee " ${BLUE}│  .  ${NC}   ${BLUE}│ ${NC}" | log_and_tee
    log_and_tee " ${BLUE}╰──────╯ ${NC}" | log_and_tee
    log_and_tee "" # Newline for spacing
    log_and_tee " ${ORANGE}--- Considered List for \"\" --- ${NC}" # The heading for an empty considered list
    log_and_tee "    Journal file not found. Cannot identify any routine." | log_and_tee # Indented message
    log_and_tee "" # Newline for spacing
fi

# Capture parsing end time
parsing_end_time=$(date +"%Y-%m-%d %H:%M:%S")

# --- Last Section ---
log_and_tee "" # Add a newline for separation
log_and_tee "" # NEW: More space before Last Section
log_and_tee "--- Last Section ---\n" # Added newline to heading for consistency with other headings.
log_and_tee "Routine Parsing Ended At: ${YELLOW}$parsing_end_time${NC}"
log_and_tee "Output Log File Path: ${BLUE}$OUTPUT_LOG_FILE${NC}"
log_and_tee "Script Finished: All output saved to '${GREEN}$OUTPUT_LOG_FILE${NC}'"
log_and_tee ""


echo "" # Final newline for terminal
echo "All logs captured to: ${GREEN}$OUTPUT_LOG_FILE${NC}"
echo "You can view its content using: cat \"$OUTPUT_LOG_FILE\""
echo "Please upload the file named 'current_routine.txt' from the folder '${BLUE}$SCRIPT_DIR${NC}' to continue (if requested)."

# --- Final Post-processing to add Quick Result at the top ---
temp_file=$(mktemp) # Create a temporary file

# Write the Quick Result header and content (plain text, no ANSI codes) to the temp file
echo "QUICK RESULT" > "$temp_file"
echo "$QUICK_RESULT_CONTENT" >> "$temp_file" # Use the already determined content
echo "" >> "$temp_file" # Blank line after quick result for separation

# Append the original content of OUTPUT_LOG_FILE (excluding its own QUICK RESULT and the problematic "Basic Section" duplication) to the temp file
# We need to skip the first few lines of the existing OUTPUT_LOG_FILE which contain the old QUICK RESULT and Basic Section
# The problematic extra "Basic Section" and "Shri Karthikeya" were added in the previous script by mistake during the final post-processing.
# Now, we are correctly ensuring only the *actual* Basic Section from the script's run is kept.
# The number '10' below is an estimation based on the previous structure.
# A safer way is to identify content and copy from there, but for simplicity, assuming a fixed offset for now.
# Let's count lines from the start of the file for the existing quick result and the intro.
# Initial quick result + blank lines + Basic Section header + static Shri Karthikeya line + blank line = 5 lines.
# So, skip the first 5 lines of the OUTPUT_LOG_FILE, as we are rewriting the quick result and basic section more accurately.
tail -n +6 "$OUTPUT_LOG_FILE" >> "$temp_file" # Adjusted to skip the first 5 lines which were hardcoded in the previous final post-processing.

# Overwrite the original OUTPUT_LOG_FILE with the content of the temp file
mv "$temp_file" "$OUTPUT_LOG_FILE"
